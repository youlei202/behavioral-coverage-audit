+            direction = 1 if str(claim["claim_id"]).startswith("C1_") else -1
+        elif claim_type == "sibling_coverage":
+            analysis_type = "sibling_removal"
+            metrics = (("sibling_inflation", "permutation_sibling_inflation"),)
