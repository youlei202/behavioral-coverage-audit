+    )
+    numeric_columns = (
+        "raw_minimum_weight",
+        "raw_sum_to_one_error",
+        "repaired_minimum_weight",
+        "repaired_sum_to_one_error",
+        "l1_weight_change",
+        "l2_weight_change",
+        "linf_weight_change",
+        "raw_objective",
+        "repaired_objective",
+        "absolute_objective_change",
